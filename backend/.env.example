# Copy this file to `.env` and adjust values as needed.

# Comma-separated list of origins allowed to call this API.
# Include the Vite dev server URL and any deployed frontend URL(s).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application environment: development | staging | production
APP_ENV=development

# Uvicorn server settings (used by run scripts, optional)
HOST=0.0.0.0
PORT=8000

# Directory (relative to backend/) used for uploaded/generated Excel files.
DATA_DIR=data

# Filename (inside DATA_DIR) of the Excel workbook containing the
# competition questions. Every sheet in this workbook becomes a category.
QUESTIONS_WORKBOOK_FILENAME=competition_questions.xlsx
