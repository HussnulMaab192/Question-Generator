# Copy this file to `.env` and adjust values as needed.

# Comma-separated list of origins allowed to call this API.
# Include the Vite / Vercel frontend URL(s) that will call this backend.
# Local development defaults:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production example (Render + Vercel):
# CORS_ORIGINS=https://your-app.vercel.app

# Application environment: development | staging | production
APP_ENV=development

# Uvicorn server settings (used by run scripts; Render sets PORT automatically)
HOST=0.0.0.0
PORT=8000

# Directory for the questions workbook.
# Relative paths are resolved from the backend/ package root (cwd-independent).
# On Render with a persistent disk, use an absolute mount path, e.g. /var/data
DATA_DIR=data

# Filename only (no directories) of the Excel workbook inside DATA_DIR.
# Every sheet becomes a selectable category.
QUESTIONS_WORKBOOK_FILENAME=competition_questions.xlsx
